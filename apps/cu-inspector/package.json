{
  "name": "cu-inspector",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Minimal local dashboard for the computer-use daemon (health, session, live frame, traces)",
  "type": "module",
  "main": "./server.mjs",
  "bin": {
    "cu-inspector": "./server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node --check server.mjs && node --check public/app.mjs",
    "typecheck": "node --check server.mjs && node --check public/app.mjs",
    "lint": "node --check server.mjs && node --check public/app.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@computer-use/sdk": "workspace:*"
  }
}
