{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    // skipLibCheck: skip type-checking third-party .d.ts files only.
    // @modelcontextprotocol/sdk's declarations reference DOM globals
    // (HeadersInit) that this node-only lib does not provide; the error is
    // in the vendor declarations, not in our code. Our own sources are
    // still fully type-checked (strict + noUncheckedIndexedAccess).
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
