{
  "name": "@computer-use/opencode-adapter",
  "version": "0.2.0-alpha.1",
  "description": "Companion CLI (cu-opencode) for using the computer-use runtime from OpenCode via its MCP server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cu-opencode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@computer-use/sdk": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  }
}
